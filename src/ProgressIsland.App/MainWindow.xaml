<Window x:Class="ProgressIsland.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="任务岛 · Progress Island" Width="360" Height="70" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
 MouseEnter="IslandEnter" MouseLeave="IslandLeave" KeyDown="IslandKeyDown">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#20222E"/><Setter Property="Foreground" Value="#ECECF7"/><Setter Property="BorderBrush" Value="#414052"/><Setter Property="Padding" Value="5"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#ECECF7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuSurface" Padding="14,8" CornerRadius="5" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="#46385F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="Transparent"/></Style>
  <DataTemplate x:Key="CompactTaskTemplate">
   <Button Width="122" Height="46" Margin="3,2" Padding="9,5" Background="#242330" Tag="{Binding Id}" Click="CompactTaskClick" ToolTip="{Binding CompactTip}" ContextMenuOpening="TaskMenuOpening" ContextMenuClosing="TaskMenuClosing">
    <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{Binding OpenLabel}" Tag="{Binding Id}" Click="InspectTask"/><Separator/><MenuItem Header="标记为未读" Tag="{Binding Id}" Click="MarkUnread"/><MenuItem Header="标记为已读" Tag="{Binding Id}" Click="MarkRead"/></ContextMenu></Button.ContextMenu>
    <Grid Width="104"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding CompactTitle}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,9,0"/>
     <Ellipse Width="6" Height="6" HorizontalAlignment="Right" Fill="#BA8CFF" Visibility="{Binding IsUnread, Converter={StaticResource BoolVisibility}}"/>
     <TextBlock Grid.Row="1" Text="{Binding CompactLabel}" Foreground="{Binding Color}" FontSize="9" Margin="0,3,0,0"/>
    </Grid>
   </Button>
  </DataTemplate>
  <Style x:Key="Meter" TargetType="ProgressBar">
   <Setter Property="Height" Value="4"/><Setter Property="Foreground" Value="#BBA7FF"/><Setter Property="Background" Value="#2A2B39"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="2"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/><Border x:Name="UnknownStripe" Width="46" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" Visibility="Collapsed"><Border.RenderTransform><TranslateTransform x:Name="Sweep"/></Border.RenderTransform></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/><Setter TargetName="UnknownStripe" Property="Visibility" Value="Visible"/><Trigger.EnterActions><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="X" From="0" To="330" Duration="0:0:1.7"/></Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="OuterFrame" Margin="9,0,9,9">
  <Border x:Name="Shell" Background="#F911121A" CornerRadius="27" BorderThickness="1" MouseLeftButtonDown="DragHeader">
   <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#71706D9B" Offset="0"/><GradientStop Color="#28383B4E" Offset="0.55"/><GradientStop Color="#514E7587" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
   <Grid x:Name="PanelContent" Margin="17,0">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="CompactHeader" Background="Transparent" MouseLeftButtonDown="DragHeader">
     <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid Width="22" Height="22" ToolTip="任务岛 · 拖动停靠，悬停展开"><Ellipse Stroke="#BBA7FF" StrokeThickness="2.5"/><Ellipse Width="4" Height="4" Fill="#A6E9E4"/><Ellipse x:Name="CompactUnread" Width="7" Height="7" Fill="#BA8CFF" Stroke="#11121A" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/></Grid>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" CanContentScroll="False" PreviewMouseWheel="CompactScrollWheel"><ItemsControl x:Name="CompactTasks" ItemTemplate="{StaticResource CompactTaskTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
     <TextBlock x:Name="CompactEmpty" Grid.Column="1" Text="暂无进行中或待确认任务" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False" Visibility="Collapsed"/>
     <Button x:Name="CompactIdle" Grid.Column="2" Content="闲置 0" Click="ShowIdle" Style="{StaticResource SmallButton}" Margin="5,0,0,0" ToolTip="查看一周无新活动的任务"/>
    </Grid>
    <Grid x:Name="Header" Visibility="Collapsed" MouseLeftButtonDown="DragHeader" Background="Transparent" ClipToBounds="True">
     <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
     <Grid Width="24" Height="24" HorizontalAlignment="Left">
      <Ellipse Stroke="#414052" StrokeThickness="2.5"/>
      <Path Stroke="#BBA7FF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,1.5 A10.5,10.5 0 1 1 2,16"/>
      <Ellipse Width="4" Height="4" Fill="#A6E9E4"/>
      <Ellipse x:Name="HeaderUnread" Width="8" Height="8" Fill="#BA8CFF" Stroke="#11121A" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" ToolTip="有尚未查看的结果"/>
     </Grid>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="Headline" Text="任务岛" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CompactDetail" Text="工作进度，抬眼可见" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <TextBlock x:Name="CompactPercent" Grid.Column="2" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="8,0,8,0" VerticalAlignment="Center"/>
     <Button x:Name="AddButton" Grid.Column="3" Content="＋" FontSize="18" Width="28" Padding="2,0" Background="Transparent" Click="AddTask" ToolTip="接入任务"/>
    </Grid>
    <Grid x:Name="ExpandedContent" Grid.Row="1" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Height="1" Background="#2A2B39" Margin="0,0,0,14"/>
     <Grid Grid.Row="1" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal"><Button x:Name="LiveTab" Content="当前任务  0" Click="ShowLive" Padding="9,6" FontSize="11"/><Button x:Name="HistoryTab" Content="结束记录  0" Click="ShowHistory" Style="{StaticResource SmallButton}" Margin="3,0,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="PinButton" Content="◇" Click="TogglePin" Style="{StaticResource SmallButton}" ToolTip="保持展开"/><Button Content="设置" Click="OpenSettings" Style="{StaticResource SmallButton}"/><Button x:Name="IdleTab" Content="闲置  0" Click="ShowIdle" Style="{StaticResource SmallButton}" Margin="5,0,0,0"/></StackPanel>
     </Grid>
     <StackPanel Grid.Row="2" Margin="2,0,2,10">
      <StackPanel Orientation="Horizontal"><TextBlock Text="无新活动后划为闲置" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button x:Name="IdleThresholdButton" Content="1 周 ▾" Click="OpenIdleThreshold" Style="{StaticResource SmallButton}" Background="#2F2941" Margin="9,0,10,0" ToolTip="选择闲置时间，修改立即生效并自动保存">
       <Button.ContextMenu><ContextMenu Opened="IdleMenuOpened" Closed="IdleMenuClosed"><MenuItem Header="30 分钟" Tag="30" Click="ChooseIdleThreshold"/><MenuItem Header="1 小时" Tag="60" Click="ChooseIdleThreshold"/><MenuItem Header="6 小时" Tag="360" Click="ChooseIdleThreshold"/><MenuItem Header="1 天" Tag="1440" Click="ChooseIdleThreshold"/><MenuItem Header="3 天" Tag="4320" Click="ChooseIdleThreshold"/><MenuItem Header="1 周" Tag="10080" Click="ChooseIdleThreshold"/><MenuItem Header="2 周" Tag="20160" Click="ChooseIdleThreshold"/><MenuItem Header="30 天" Tag="43200" Click="ChooseIdleThreshold"/><Separator/><MenuItem Header="自定义…" Click="ShowCustomIdle"/></ContextMenu></Button.ContextMenu>
      </Button><TextBlock Text="自动保存" FontSize="9.5" Foreground="#73788E" VerticalAlignment="Center"/></StackPanel>
      <StackPanel x:Name="CustomIdlePanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="自定义" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="IdleAmount" Width="62" MaxLength="6" Padding="7,4" Text="7"/><RadioButton x:Name="IdleMinutesUnit" Content="分钟" GroupName="IdleUnits" FontSize="10.5" Foreground="#D5D7E5" VerticalAlignment="Center" Margin="12,0,6,0"/><RadioButton x:Name="IdleHoursUnit" Content="小时" GroupName="IdleUnits" FontSize="10.5" Foreground="#D5D7E5" VerticalAlignment="Center" Margin="0,0,6,0"/><RadioButton x:Name="IdleDaysUnit" Content="天" GroupName="IdleUnits" IsChecked="True" FontSize="10.5" Foreground="#D5D7E5" VerticalAlignment="Center" Margin="0,0,6,0"/><RadioButton x:Name="IdleWeeksUnit" Content="周" GroupName="IdleUnits" FontSize="10.5" Foreground="#D5D7E5" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Content="应用" Click="ApplyCustomIdle" Style="{StaticResource SmallButton}" Background="#46335F"/></StackPanel>
      <TextBlock x:Name="IdleValidation" Visibility="Collapsed" Foreground="#FF8B9E" FontSize="10" Margin="0,6,0,0"/>
      <TextBlock x:Name="HistoryHint" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0"/>
     </StackPanel>
     <Grid Grid.Row="3">
      <ScrollViewer x:Name="TaskScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
       <ItemsControl x:Name="TaskList"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="#1D1E2A" CornerRadius="14" Padding="14" Margin="0,0,0,9" BorderBrush="#2A2C3A" BorderThickness="1" ContextMenuOpening="TaskMenuOpening" ContextMenuClosing="TaskMenuClosing">
         <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="{Binding OpenLabel}" Tag="{Binding Id}" Click="InspectTask"/>
          <Separator/>
          <MenuItem Header="标记为未读" Tag="{Binding Id}" Click="MarkUnread"/>
          <MenuItem Header="标记为已读" Tag="{Binding Id}" Click="MarkRead"/>
         </ContextMenu></Border.ContextMenu>
         <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#BA8CFF" Margin="0,0,8,0" Visibility="{Binding IsUnread, Converter={StaticResource BoolVisibility}}" ToolTip="未读 · 右键可更改"/><TextBlock Text="{Binding Glyph}" Foreground="{Binding Color}" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,9,0"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" MaxWidth="265" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding PercentLabel}" FontSize="12" Foreground="{Binding Color}" Margin="10,0,0,0"/>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,9,0,10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
          <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Meter}" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" Foreground="{Binding Color}"/>
          <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding State}" Foreground="{Binding Color}" FontSize="10"/><TextBlock Text="{Binding Metadata}" Foreground="#74798E" FontSize="9.5" Margin="0,3,0,0"/></StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="确认" Tag="{Binding Id}" Click="MarkRead" Style="{StaticResource SmallButton}" Background="#46335F" Visibility="{Binding NeedsConfirmation, Converter={StaticResource BoolVisibility}}" ToolTip="确认此轮结果；记录保留在结束记录中"/><Button Content="{Binding OpenLabel}" Tag="{Binding Id}" Click="InspectTask" Style="{StaticResource SmallButton}" ToolTip="打开会话或任务详情，并标记已读"/><Button Content="×" Tag="{Binding Id}" Click="RemoveTask" Style="{StaticResource SmallButton}" ToolTip="仅移除监控，不停止任务"/></StackPanel>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer>
      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15,28">
       <TextBlock x:Name="EmptyHeading" Text="暂无正在处理的任务" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       <TextBlock x:Name="EmptyCaption" Text="运行脚本、接入软件，或跟随一份日志。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,20" HorizontalAlignment="Center"/>
       <Button Content="＋  接入第一个任务" Click="AddTask" Background="#3D3357" HorizontalAlignment="Center" Padding="18,10"/>
       <TextBlock Text="没有进度信息时，会明确显示「进度未知」。" Foreground="#73788E" FontSize="10" HorizontalAlignment="Center" Margin="0,16,0,0"/>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="4" Margin="2,6,2,13"><TextBlock x:Name="Footer" Text="●  本机运行" FontSize="9.5" Foreground="#7F869C"/><TextBlock Text="Ctrl + Alt + P  显示 / 隐藏" FontSize="9.5" Foreground="#666D85" HorizontalAlignment="Right"/></Grid>
    </Grid>
   </Grid>
   <!-- A true vertical layout, rather than rotated text, when parked on either side. -->
  </Border>
  <Border x:Name="Rail" Visibility="Collapsed" Background="Transparent" Margin="1,9,1,10" MouseLeftButtonDown="DragHeader" ToolTip="拖到任意屏幕边缘停靠；悬停展开">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Grid Width="25" Height="25" HorizontalAlignment="Center"><Ellipse Stroke="#414052" StrokeThickness="2.5"/><Path Stroke="#BBA7FF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,1.5 A10.5,10.5 0 1 1 2,16"/><Ellipse Width="4" Height="4" Fill="#A6E9E4"/><Ellipse x:Name="RailUnread" Width="8" Height="8" Fill="#BA8CFF" Stroke="#11121A" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" ToolTip="有未读结果"/></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><ItemsControl x:Name="RailTasks" ItemTemplate="{StaticResource CompactTaskTemplate}"/></ScrollViewer>
    <TextBlock x:Name="RailEmpty" Grid.Row="1" Text="暂无待办" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
    <Button x:Name="RailIdle" Grid.Row="2" Content="闲置 0" Click="ShowIdle" FontSize="10" Padding="3,2" Background="Transparent" ToolTip="查看闲置任务" HorizontalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>
