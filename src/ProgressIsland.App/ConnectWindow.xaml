<Window x:Class="ProgressIsland.App.ConnectWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="接入任务 · 任务岛" Style="{StaticResource {x:Type Window}}" Width="650" Height="620" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" MinWidth="580" MinHeight="550">
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="接入一项工作" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="让代码和软件，把正在发生的事告诉你。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
  <UniformGrid Grid.Row="1" Columns="4" Margin="0,24,0,20"><Button x:Name="CommandTab" Content="运行命令" Tag="command" Click="ChooseMode" Margin="0,0,5,0"/><Button x:Name="ProcessTab" Content="已有程序" Tag="process" Click="ChooseMode" Margin="0,0,5,0"/><Button x:Name="LogTab" Content="跟随日志" Tag="log" Click="ChooseMode" Margin="0,0,5,0"/><Button x:Name="ApiTab" Content="脚本上报" Tag="api" Click="ChooseMode"/></UniformGrid>
  <StackPanel Grid.Row="2" Margin="0,0,0,16"><TextBlock Text="任务名称（可选）" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,7"/><TextBox x:Name="TaskTitle" MaxLength="180"/></StackPanel>
  <Grid Grid.Row="3">
   <StackPanel x:Name="CommandPane"><TextBlock Text="PowerShell 命令" Margin="0,0,0,7"/><TextBox x:Name="CommandText" AcceptsReturn="True" TextWrapping="Wrap" Height="105" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/><TextBlock Text="工作目录（留空使用当前目录）" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,16,0,7"/><TextBox x:Name="DirectoryText"/><TextBlock Text="支持百分比、Epoch 3/10、tqdm、FFmpeg 等输出。无进度时显示运行状态，按退出码判断成功或失败。&#10;关闭灵动岛不会停止从这里启动的命令。命令请使用非交互模式。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="19" Margin="0,15,0,0"/></StackPanel>
   <Grid x:Name="ProcessPane" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><Button Content="刷新" DockPanel.Dock="Right" Margin="8,0,0,0" Click="RefreshProcesses"/><TextBox x:Name="ProcessFilter" TextChanged="FilterProcesses" ToolTip="按程序名、窗口标题或 PID 搜索；搜索时也列出无窗口进程"/></DockPanel><ListBox x:Name="ProcessList" Grid.Row="1" DisplayMemberPath="Label"/><TextBlock Grid.Row="2" Text="读取软件公开的进度条；未提供时显示「进度未知」。进程退出只记为「已退出」，不会冒充内部工作已完成。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></Grid>
   <StackPanel x:Name="LogPane" Visibility="Collapsed"><TextBlock Text="日志文件" Margin="0,0,0,7"/><DockPanel><Button Content="选择文件" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseLog"/><TextBox x:Name="LogPath"/></DockPanel><TextBlock Text="读取 UTF-8 文本日志的新内容，识别百分比、阶段计数和 FFmpeg 时间。支持正在被其他程序写入的日志。&#10;&#10;日志停止更新不代表任务完成。需要准确的结束通知时，请使用脚本上报，或从「运行命令」启动。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="20" Margin="0,20,0,0"/></StackPanel>
   <StackPanel x:Name="ApiPane" Visibility="Collapsed"><TextBlock Text="Python / PowerShell / 其他软件" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="使用本机 HTTP 接口上报准确的进度、阶段和最终结果。&#10;接口仅监听 127.0.0.1，带本机令牌，不接收远程命令。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,16"/><TextBox x:Name="ApiExample" IsReadOnly="True" AcceptsReturn="True" Height="120" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/><Button Content="复制 PowerShell 上报示例" Click="CopyExample" HorizontalAlignment="Left" Margin="0,14,0,0"/><TextBlock Text="项目 sdk 文件夹另含 Python 上下文管理器和 PowerShell 辅助函数。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel>
  </Grid>
  <Grid Grid.Row="4" Margin="0,20,0,0"><TextBlock x:Name="ErrorText" Foreground="#FF9BA9" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="360" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Click="Cancel" Margin="0,0,9,0"/><Button x:Name="ConnectButton" Content="开始运行" Background="#51406F" Click="Connect" Padding="18,9"/></StackPanel></Grid>
 </Grid>
</Window>
