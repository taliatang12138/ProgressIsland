<Window x:Class="ProgressIsland.App.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="设置 · 任务岛" Style="{StaticResource {x:Type Window}}" Width="530" Height="690" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <Grid Margin="27"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="让岛按你的方式工作" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="保存后生效，数据保存在这台电脑。" Foreground="{StaticResource Muted}" Margin="0,10,0,21"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <CheckBox x:Name="StartWithWindows" Content="开机自启动：登录 Windows 后自动打开任务岛"/>
   <TextBlock x:Name="StartupStatus" Text="仅对当前 Windows 账号生效，无需管理员权限。" Foreground="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="21,0,0,13"/>
   <CheckBox x:Name="TrackCodex" Content="显示 Codex 会话与未读结果"/><TextBlock Text="读取本机最新轮次状态；打开对应会话后清除紫色未读点。&#10;会话卡片支持右键标记未读，悬停不会清除标记。" Foreground="{StaticResource Muted}" FontSize="10.5" LineHeight="17" Margin="21,0,0,10"/>
   <TextBlock x:Name="IdleSummary" FontSize="11" Margin="0,0,0,6"/>
   <TextBlock Text="在任务岛展开界面直接选择闲置时间，修改自动保存。" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,0,0,13"/>
   <CheckBox x:Name="Auto" Content="自动发现计算进程与终端外部命令"/><TextBlock Text="Python、MATLAB、FFmpeg，以及终端中的 npm、dotnet、git 等。&#10;终端内置命令需从岛启动；外部命令退出不直接判定成功。" Foreground="{StaticResource Muted}" FontSize="10.5" LineHeight="17" Margin="21,0,0,10"/>
   <CheckBox x:Name="ReadBars" Content="读取接入软件公开的进度条"/><TextBlock Text="使用 Windows 辅助功能接口；不支持的控件显示进度未知。" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="21,0,0,10"/>
   <CheckBox x:Name="Notify" Content="任务结束时显示提醒"/><CheckBox x:Name="Sound" Content="播放完成提示音"/>
   <Border Height="1" Background="#30323F" Margin="0,15"/>
   <TextBlock Text="本机上报接口" FontWeight="SemiBold"/><TextBlock x:Name="Endpoint" Foreground="{StaticResource Accent}" FontFamily="Consolas" Margin="0,8,0,7"/>
   <TextBlock Text="默认需要本机令牌；在接入任务 → 脚本上报中获取示例。&#10;CPU / 内存仅作为资源信息，不用于估算完成百分比。" Foreground="{StaticResource Muted}" FontSize="10.5" LineHeight="18"/>
   <StackPanel Orientation="Horizontal" Margin="0,17,0,0"><Button Content="打开数据目录" Click="OpenData" Margin="0,0,10,0"/><Button Content="清空历史记录" Click="ClearHistory"/></StackPanel>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="退出任务岛" Click="Quit" Margin="0,0,10,0"/><Button Content="保存" Click="Save" Background="#51406F" Padding="23,9"/></StackPanel>
 </Grid>
</Window>
